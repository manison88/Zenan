{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "zenan-fleet",
  "compatibility_date": "2026-04-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "zenan.312itconsulting.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zenan-fleet-db",
      "database_id": "428ca96c-f279-4e9c-9e27-887a1c405965",
      "migrations_dir": "src/db/migrations"
    }
  ],

  // ── Preview environment ────────────────────────────────────────────────
  // Deploy with:  npx opennextjs-cloudflare deploy -- --env preview
  // Lives at:     https://zenan-fleet-preview.manison88.workers.dev
  //
  // Hard-locked to the workers.dev subdomain only — explicit empty `routes`
  // overrides the top-level route inheritance so preview deploys CANNOT
  // claim zenan.312itconsulting.com even if wrangler prompts about it.
  // `workers_dev: true` is the default but kept explicit so the intent is
  // obvious: this worker only serves on *.workers.dev.
  //
  // Separate D1 database so prod data is never touched by preview tests.
  "env": {
    "preview": {
      "name": "zenan-fleet-preview",
      "workers_dev": true,
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zenan-fleet-db-preview",
          "database_id": "2e23cea7-fb8e-4a17-8913-eae9707ad296",
          "migrations_dir": "src/db/migrations"
        }
      ]
    }
  }
}
